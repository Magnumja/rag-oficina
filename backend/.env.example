# Provedor do modelo de chat: "anthropic", "openai" ou "ollama" (sem chave/Ollama = modo demonstração).
# Isto é só o fallback de demonstração/turma: cada aluno pode colar a própria chave
# Anthropic/OpenAI na tela "Minha IA" do app, que viaja por requisição e nunca é
# guardada no servidor nem no banco.
MODEL_PROVIDER=anthropic
# Chave da API da Anthropic do servidor (fallback de demonstração; fica só aqui, nunca no navegador)
ANTHROPIC_API_KEY=
# Chave da API da OpenAI do servidor (mesmo papel de fallback que a de cima)
OPENAI_API_KEY=
# Modelo usado nas respostas (ex.: claude-haiku-5-5 no provedor anthropic, llama3.2:1b no ollama)
LLM_MODEL=claude-haiku-5-5
# Host do Ollama, só é usado quando MODEL_PROVIDER=ollama (ex. em Docker: http://host.docker.internal:11434)
OLLAMA_HOST=http://localhost:11434
# Modelo de embedding multilíngue, fixo via Ollama (independe do provedor de chat)
EMBEDDING_MODEL=bge-m3
# Quantos trechos buscar por pergunta
TOP_K=4
# Similaridade mínima para considerar um trecho relevante (abaixo disso: "nada relevante encontrado")
SIMILARITY_THRESHOLD=0.5
# Origens liberadas (adicione o IP do servidor se os alunos acessarem pela rede)
CORS_ORIGINS=http://localhost:5173
