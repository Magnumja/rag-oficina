# Chave da API da Anthropic (fica só no servidor, nunca no navegador)
ANTHROPIC_API_KEY=
# Modelo usado nas respostas
LLM_MODEL=claude-haiku-5-5
# Quantos trechos buscar por pergunta
TOP_K=4
# Origens liberadas (adicione o IP do servidor se os alunos acessarem pela rede)
CORS_ORIGINS=http://localhost:5173
